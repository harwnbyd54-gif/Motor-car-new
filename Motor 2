def simulate_flying_car_engine():
    print("=" * 60)
    print("محاكاة نظام الدفع والرفع (الهواء المضغوط vs المحرك النفاث الحقيقي)")
    print("=" * 60)
    
    # ثوابت السيارة
    car_weight_kg = 1500.0
    required_thrust = car_weight_kg * 9.81  # القوة المطلوبة للرفع بالنيوتن
    
    print(f"وزن السيارة المستهدف: {car_weight_kg} كجم")
    print(f"قوة الرفع المطلوبة للإقلاع: {required_thrust:.2f} نيوتن\n")
    
    # ----------------------------------------------------
    # الحالة الأولى: الاعتماد على ضغط الهواء ونقله في أنبوب فقط (بدون وقود)
    # ----------------------------------------------------
    m_dot = 25.0       # معدل تدفق الكتلة (كجم/ثانية)
    v_initial = 30.0   # سرعة دخول الهواء (م/ث)
    v_exit_cold = 150.0# سرعة خروج الهواء المضغوط برداً
    
    thrust_cold = m_dot * (v_exit_cold - v_initial)
    
    print("--- السيناريو الأول: الضغط الهوائي/الميكانيكي البحت ---")
    print(f"قوة الدفع الناتجة: {thrust_cold:.2f} نيوتن")
    if thrust_cold >= required_thrust:
        print("النتيجة: كافية للإقلاع! (ناجح)\n")
    else:
        deficit = required_thrust - thrust_cold
        print(f"النتيجة: غير كافية للإقلاع. يوجد عجز قدره: {deficit:.2f} نيوتن.\n")
        
    # ----------------------------------------------------
    # الحالة الثانية: إضافة الاحتراق الداخلي والتوربينات (محرك نفاث حقيقي)
    # ----------------------------------------------------
    # حرارة الاحتراق ترفع سرعة الخروج بشكل هائل
    v_exit_hot = 600.0 # سرعة خروج الغازات الساخنة من الفوهة
    
    thrust_hot = m_dot * (v_exit_hot - v_initial)
    
    print("--- السيناريو الثاني: دمج الضغط مع الاحتراق النفاث (مثل محركات الطائرات) ---")
    print(f"قوة الدفع الناتجة: {thrust_hot:.2f} نيوتن")
    if thrust_hot >= required_thrust:
        print("النتيجة: قوة هائلة وكافية جداً لرفع السيارة والإقلاع بنجاح تام! (ناجح)")
    else:
        print("النتيجة: غير كافية.")
    print("=" * 60)

# تشغيل المحاكاة
simulate_flying_car_engine()
